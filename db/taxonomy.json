{
  "v": 4,
  "about": "사례 DB의 분류 체계. 모든 메타데이터는 여기 있는 id 중에서 고른다(집계·추론용). 지표 체계는 'AI 사주 웹툰형 서비스, 최종 지표 = 결제'를 뿌리로 설계했고, 다른 업종 사례도 같은 축으로 비교할 수 있게 일반 지표를 함께 둔다.",

  "payment_tree": {
    "root": "revenue",
    "formula": "결제 매출 = 결제자 수 × ARPPU",
    "nodes": {
      "revenue": ["payers", "arppu"],
      "payers": ["new_payers", "repeat_payers"],
      "new_payers": ["visitors", "signup_rate", "first_value_rate", "next_episode_rate", "paywall_view_rate", "first_pay_conv"],
      "repeat_payers": ["repeat_pay_rate", "d30_retention", "sub_conv", "reactivation"],
      "arppu": ["aov", "pay_frequency", "upsell_rate", "price_level"]
    },
    "guardrails": ["refund_rate", "rating", "unit_cost", "gross_margin", "cac"]
  },

  "funnel_stages": {
